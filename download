# FreshBite Pets: Apache (hospedagem compartilhada). Vai junto com o conteúdo de dist/.
Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + www (manter igual ao "site" em astro.config.mjs; trocar se o domínio final for sem www)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

  # Cada página é uma pasta (services/index.html). URL oficial sem barra final.
  # /pagina/index.html e /pagina/ -> /pagina (301)
  RewriteCond %{THE_REQUEST} \s/+(.*?)/?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /pagina -> serve pagina/index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Arquivos com hash do Astro nunca mudam
  <FilesMatch "\.(webp|avif|jpe?g|png|svg|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

AddType image/webp .webp
AddType image/avif .avif
AddType font/woff2 .woff2
