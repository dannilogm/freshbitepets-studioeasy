{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:page(services|about|contact|privacy-policy).html", "destination": "/:page", "permanent": true }
  ],
  "rewrites": [
    { "source": "/:page(services|about|contact|privacy-policy)", "destination": "/:page/index.html" }
  ]
}
